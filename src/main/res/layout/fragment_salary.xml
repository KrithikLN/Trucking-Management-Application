<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1">

    <!-- Header -->
    <TextView
        android:id="@+id/textViewHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Manage Driver Salary"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:background="#2196F3"
        android:padding="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Driver Info -->
    <LinearLayout
        android:id="@+id/layoutDriverInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewHeader">

        <TextView
            android:id="@+id/textViewDriverId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver ID: ABC123"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textViewDriverName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Name: John Doe"
            android:textSize="18sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textViewCurrentSalary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Salary: 50,000"
            android:textSize="18sp"
            android:textColor="#333333"/>
    </LinearLayout>

    <!-- New Salary Input -->
    <EditText
        android:id="@+id/editTextNewSalary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter New Salary"
        android:inputType="number"
        android:background="#FFFFFF"
        android:textColor="#333333"
        android:layout_margin="24dp"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutDriverInfo"/>

    <!-- Update Salary Button -->
    <Button
        android:id="@+id/buttonUpdateSalary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Update Salary"
        android:textColor="#FFFFFF"
        android:background="#2196F3"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextNewSalary"/>

</androidx.constraintlayout.widget.ConstraintLayout>
